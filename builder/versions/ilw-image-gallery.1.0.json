    "samples": [
        {
            "name": "default",
            "description": "Default information",
            "text": "<ilw-grid width=\"page\" gap=\"25px\" padding=\"0\"><a data-gallery-item href=\"https://picsum.photos/id/13/2500/1667\" data-gallery-alt=\"A beach with pine trees in the distance\">\n<ilw-card aspectratio=\"16/10\">\n<img src=\"https://picsum.photos/id/13/570/300\" alt=\"\" slot=\"image\">\n<p>A beach with pine trees in the distance</p>\n</ilw-card>\n</a>\n\n            <a data-gallery-item href=\"https://picsum.photos/id/16/2500/1667\" data-gallery-alt=\"A rocky shoreline beneath a cloudy sky\">\n                <ilw-card aspectratio=\"16/10\">\n                    <img src=\"https://picsum.photos/id/16/570/300\" alt=\"\" slot=\"image\">\n                    <p>A rocky shoreline beneath a cloudy sky</p>\n                </ilw-card>\n            </a>\n\n            <a data-gallery-item href=\"https://picsum.photos/id/18/2500/1667\" data-gallery-alt=\"Tall grass overlooking the ocean\">\n                <ilw-card aspectratio=\"16/10\">\n                    <img src=\"https://picsum.photos/id/18/570/300\" alt=\"\" slot=\"image\">\n                    <p>Tall grass overlooking the ocean</p>\n                </ilw-card>\n            </a>\n        </ilw-grid>"
        },
        {
            "name": "no-caption",
            "description": "Gallery without captions",
            "text": "<ilw-grid width=\"page\" gap=\"25px\" padding=\"0\"><a data-gallery-item href=\"https://picsum.photos/id/13/2500/1667\" data-gallery-alt=\"A beach with pine trees in the distance\">\n<ilw-card aspectratio=\"16/10\">\n<img src=\"https://picsum.photos/id/13/570/300\" alt=\"\" slot=\"image\">\n</ilw-card>\n</a>\n\n            <a data-gallery-item href=\"https://picsum.photos/id/16/2500/1667\" data-gallery-alt=\"A rocky shoreline beneath a cloudy sky\">\n                <ilw-card aspectratio=\"16/10\">\n                    <img src=\"https://picsum.photos/id/16/570/300\" alt=\"\" slot=\"image\">\n                </ilw-card>\n            </a>\n\n            <a data-gallery-item href=\"https://picsum.photos/id/18/2500/1667\" data-gallery-alt=\"Tall grass overlooking the ocean\">\n                <ilw-card aspectratio=\"16/10\">\n                    <img src=\"https://picsum.photos/id/18/570/300\" alt=\"\" slot=\"image\">\n                </ilw-card>\n            </a>\n        </ilw-grid>"
        }
